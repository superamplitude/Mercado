NODE_ENV=production
PORT=3010
APP_URL=https://mercado.superamplitude.com
IMAGE_BASE_URL=https://imagens.mercado.superamplitude.com
IMAGE_STORAGE_DIR=/home/mercado/media/products

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mercado
DB_USER=mercado
DB_PASSWORD=
DB_CREATE_DATABASE=false

JWT_SECRET=
ADMIN_EMAIL=admin@superamplitude.com
ADMIN_PASSWORD=

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_URL=https://mercado.superamplitude.com/api/webhooks/mercadopago
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.paypal.com

DELIVERY_BASE_FEE=8.90
FREE_DELIVERY_FROM=199.00
STORE_NAME=Mercado SuperAmplitude
STORE_WHATSAPP=

# API Open Food Facts: use apenas para lotes pequenos/testes.
OFF_BASE_URL=https://world.openfoodfacts.org/api/v2/search
OFF_COUNTRY=brazil
OFF_PAGE_SIZE=100
OFF_MAX_PAGES=10
OFF_DELAY_MS=6500
OFF_DOWNLOAD_IMAGES=true

# Carga em massa: indicada para catálogo grande.
OFF_BULK_URL=https://static.openfoodfacts.org/data/openfoodfacts-products.jsonl.gz
OFF_BULK_COUNTRY_TAG=en:brazil
MIRROR_IMAGE_LIMIT=0
